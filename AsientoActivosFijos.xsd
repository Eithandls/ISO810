<?xml version="1.0" encoding="UTF-8"?>
<!--
  Esquema: Interfaz Activos Fijos -> Contabilidad (PeachTree)
  Empresa: Maderera Madeco
  Versión: 1.0
  Descripción: Define la estructura del archivo XML que el Sistema de
               Activos Fijos genera para que PeachTree importe los asientos.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns="http://www.madeco.com.do/contabilidad/asientos"
           xmlns:m="http://www.madeco.com.do/contabilidad/asientos"
           targetNamespace="http://www.madeco.com.do/contabilidad/asientos"
           elementFormDefault="qualified"
           version="1.0">

  <!-- ===================== TIPOS SIMPLES ===================== -->

  <!-- 1. Número del asiento: ej. AF-2026-000123 -->
  <xs:simpleType name="NumeroAsientoType">
    <xs:restriction base="xs:string">
      <xs:pattern value="[A-Z0-9\-]{1,20}"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- 2. Descripción (asiento o línea) -->
  <xs:simpleType name="DescripcionType">
    <xs:restriction base="xs:string">
      <xs:minLength value="1"/>
      <xs:maxLength value="150"/>
      <xs:whiteSpace value="collapse"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- 4. Cuenta contable según catálogo de PeachTree (máx. 15 caracteres) -->
  <xs:simpleType name="CuentaContableType">
    <xs:restriction base="xs:string">
      <xs:pattern value="[A-Za-z0-9\-\.]{1,15}"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- 5. Tipo de movimiento: DB = Débito, CR = Crédito -->
  <xs:simpleType name="TipoMovimientoType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="DB"/>
      <xs:enumeration value="CR"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- 6. Monto: positivo, hasta 13 enteros y 2 decimales -->
  <xs:simpleType name="MontoType">
    <xs:restriction base="xs:decimal">
      <xs:totalDigits value="15"/>
      <xs:fractionDigits value="2"/>
      <xs:minExclusive value="0"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Moneda ISO 4217 (DOP, USD...) -->
  <xs:simpleType name="MonedaType">
    <xs:restriction base="xs:string">
      <xs:pattern value="[A-Z]{3}"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- ===================== TIPOS COMPLEJOS ===================== -->

  <!-- Línea (movimiento) del asiento -->
  <xs:complexType name="MovimientoType">
    <xs:sequence>
      <xs:element name="Cuenta"          type="CuentaContableType"/>
      <xs:element name="TipoMovimiento"  type="TipoMovimientoType"/>
      <xs:element name="Monto"           type="MontoType"/>
      <xs:element name="DescripcionLinea" type="DescripcionType" minOccurs="0"/>
      <xs:element name="CodigoActivo"    type="xs:string"        minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="linea" type="xs:positiveInteger" use="required"/>
  </xs:complexType>

  <!-- Totales de control (deben cuadrar: TotalDebito = TotalCredito) -->
  <xs:complexType name="TotalesType">
    <xs:sequence>
      <xs:element name="TotalDebito"  type="MontoType"/>
      <xs:element name="TotalCredito" type="MontoType"/>
    </xs:sequence>
  </xs:complexType>

  <!-- Asiento contable -->
  <xs:complexType name="AsientoType">
    <xs:sequence>
      <xs:element name="NumeroAsiento" type="NumeroAsientoType"/>
      <xs:element name="Descripcion"   type="DescripcionType"/>
      <xs:element name="Fecha"         type="xs:date"/>
      <xs:element name="Movimientos">
        <xs:complexType>
          <xs:sequence>
            <!-- Partida doble: mínimo un débito y un crédito -->
            <xs:element name="Movimiento" type="MovimientoType"
                        minOccurs="2" maxOccurs="unbounded"/>
          </xs:sequence>
        </xs:complexType>
        <!-- El número de línea no se repite dentro del asiento -->
        <xs:unique name="LineaUnica">
          <xs:selector xpath="m:Movimiento"/>
          <xs:field xpath="@linea"/>
        </xs:unique>
      </xs:element>
      <xs:element name="Totales" type="TotalesType"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ===================== ELEMENTO RAÍZ ===================== -->

  <xs:element name="LoteAsientos">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="Asiento" type="AsientoType" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="sistemaOrigen"    type="xs:string"   use="required" fixed="ACTIVOS_FIJOS"/>
      <xs:attribute name="compania"         type="xs:string"   use="required"/>
      <xs:attribute name="fechaGeneracion"  type="xs:dateTime" use="required"/>
      <xs:attribute name="moneda"           type="MonedaType"  default="DOP"/>
      <xs:attribute name="cantidadAsientos" type="xs:positiveInteger" use="required"/>
    </xs:complexType>
    <!-- El número de asiento no se repite dentro del lote -->
    <xs:unique name="NumeroAsientoUnico">
      <xs:selector xpath="m:Asiento"/>
      <xs:field xpath="m:NumeroAsiento"/>
    </xs:unique>
  </xs:element>

</xs:schema>
